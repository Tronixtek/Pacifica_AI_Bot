APP_ENV=development
SERVICE_NAME=vtfx-mt5-trader
FRONTEND_ORIGIN=http://127.0.0.1:3000
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=logs/audit.jsonl
BOT_MODE=paper
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_MAGIC_NUMBER=990211
MT5_DEVIATION_POINTS=20
MT5_CONNECT_TIMEOUT_MS=10000
# Blank = auto-detect broker suffix (Exness Standard uses 'm').
SYMBOL_SUFFIX=
SYMBOLS=EURUSD,XAUUSD,BTCUSD
USE_SIMULATED_FEED=true
ENABLE_LIVE_TRADING=false
POLL_INTERVAL_SEC=2.0
ACCOUNT_SYNC_INTERVAL_SEC=10.0
MARKET_DATA_STALE_AFTER_SEC=15.0
STARTING_EQUITY_USD=10000
MAX_RISK_PER_TRADE_PCT=0.75
MIN_SIGNAL_CONFIDENCE=0.72
MAX_DAILY_LOSS_PCT=3.0
ENFORCE_DAILY_LOSS_LIMIT=true
MAX_OPEN_POSITIONS=5
DEFAULT_LEVERAGE=3.0
CONTRARIAN_TARGET_RISK_MULTIPLE=0.25
TRAILING_STOP_ENABLED=true
TRAIL_ACTIVATE_R=0.25
TRAIL_ATR_MULTIPLE=0.5
SIGNAL_COOLDOWN_SECONDS=45
STRATEGY_TIMEFRAME=15m
STRATEGY_BAR_COUNT=400
BAR_REFRESH_INTERVAL_SEC=15.0
PRICE_ACTION_BREAKOUT_WINDOW=20
PRICE_ACTION_SWEEP_WINDOW=12
PRICE_ACTION_TREND_FAST_WINDOW=8
PRICE_ACTION_TREND_SLOW_WINDOW=34
PRICE_ACTION_MOMENTUM_WINDOW=5
PRICE_ACTION_BREAKOUT_ATR_MULTIPLE=0.15
PRICE_ACTION_MIN_TREND_SEPARATION_ATR=0.25
PRICE_ACTION_MIN_STOP_ATR_MULTIPLE=0.6
PRICE_ACTION_MIN_STOP_SPREAD_MULTIPLE=3.0
ENABLED_SETUPS=breakout
PRICE_ACTION_REWARD_TO_RISK=2.1
ML_ENABLED=false
ML_CANDLE_INTERVAL=1m
ML_TRAINING_LOOKBACK_CANDLES=720
ML_PREDICTION_HORIZON_BARS=5
ML_TARGET_MOVE_PCT=0.18
ML_MIN_TRADE_PROBABILITY=0.58
ML_PROBABILITY_EDGE=0.04
ML_RETRAIN_INTERVAL_SEC=1800
ML_PREFER_LOCAL_DATASET=true
ML_DATASET_ROOT=data/training
ML_LOAD_ARTIFACT_ON_STARTUP=true
ML_MODEL_ARTIFACT_PATH=models/ml_signal_model.json
PERSIST_RUNTIME_STATE=true
STATE_STORE_PATH=data/state/runtime.sqlite3
STATE_CHECKPOINT_INTERVAL_SEC=5.0

# --- fixed-cash-target scalper (python -m app.scalper) ---
SCALPER_SYMBOLS=BTCUSD,GBPUSD,EURUSD,USDJPY,XAUUSD
SCALPER_SYMBOL=BTCUSD
SCALPER_TARGET_USD=0.20
SCALPER_STOP_USD=4.00
SCALPER_LOTS=0
SCALPER_SIDE=alternate
SCALPER_MAX_OPEN_POSITIONS=5
SCALPER_MAGIC_NUMBER=990212
SCALPER_MAX_DRAWDOWN_USD=25.0
SCALPER_MAX_CONSECUTIVE_LOSSES=5
SCALPER_MAX_TRADES=0

# --- CRT bot (magic 990213) ---
CRT_ENABLED=true
CRT_MAGIC_NUMBER=990213
CRT_EXECUTION_TIMEFRAME=5m
CRT_RANGE_FACTOR=3
CRT_MAX_OPEN_POSITIONS=5
CRT_RISK_PER_TRADE_PCT=0.5
CRT_MIN_SWEEP_ATR=0.1
CRT_STOP_BUFFER_ATR=0.25
CRT_TRAIL_ACTIVATE_R=0.25
CRT_TRAIL_ATR_MULTIPLE=0.5
